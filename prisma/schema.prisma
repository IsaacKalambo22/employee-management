// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String?
  role        Role     @default(EMPLOYEE)
  employeeId  String?  @unique
  employee    Employee? @relation(fields: [employeeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id            String            @id @default(uuid())
  firstName     String
  lastName      String
  phone         String?
  email         String?           @unique
  departmentId  String?
  positionId    String?
  hireDate      DateTime
  status        EmploymentStatus  @default(ACTIVE)
  grade         String?           // Employee grade (e.g., "9", "8", "7", etc.)
  lineManagerId String?           // Direct line manager
  lineManager   Employee?         @relation("LineManager", fields: [lineManagerId], references: [id])
  directReports Employee[]        @relation("LineManager")
  user          User?
  department    Department?       @relation(fields: [departmentId], references: [id])
  position      Position?         @relation(fields: [positionId], references: [id])
  documents     EmployeeDocument[]
  emergencyContacts EmergencyContact[]
  managedDepartments Department[] @relation("DepartmentManager")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  requisitions  Requisition[]
  attendance    Attendance[]
  salary        Salary?
  payslips      Payslip[]
  deductions    Deduction[]
  loanApplications LoanApplication[]
  proposedProjects Project[]       @relation("ProjectProposer")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  managerId   String?
  manager     Employee? @relation("DepartmentManager", fields: [managerId], references: [id])
  employees   Employee[]
  budgets     DepartmentBudget[]
  projects    Project[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Position {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?
  level       String?
  department  String?
  employees   Employee[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeDocument {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  documentType String
  fileName    String
  filePath    String
  uploadedAt  DateTime @default(now())
}

model EmergencyContact {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  name        String
  relationship String
  phone       String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Leave Management Models
model LeavePolicy {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  daysPerYear   Int
  carryOver     Boolean  @default(false)
  maxCarryOver  Int      @default(0)
  grade         String?  // Optional grade-specific policy (e.g., "9", "8", "7-3")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  balances      LeaveBalance[]
  requests      LeaveRequest[]
}

model LeaveBalance {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId      String
  policy        LeavePolicy @relation(fields: [policyId], references: [id])
  year          Int
  allocated     Int
  used          Int         @default(0)
  pending       Int         @default(0)
  carriedOver   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([employeeId, policyId, year])
}

model LeaveRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  policyId      String
  policy        LeavePolicy   @relation(fields: [policyId], references: [id])
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  status        LeaveStatus   @default(PENDING)
  workflowInstanceId String?  // Link to workflow instance
  approvals     LeaveApproval[]
  attachments   LeaveAttachment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model LeaveApproval {
  id            String        @id @default(uuid())
  requestId     String
  request       LeaveRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId    String
  level         Int
  status        ApprovalStatus @default(PENDING)
  comment       String?
  actedAt       DateTime?
  createdAt     DateTime      @default(now())
}

model LeaveAttachment {
  id            String       @id @default(uuid())
  requestId     String
  request       LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName      String
  filePath      String
  uploadedAt    DateTime     @default(now())
}

// Requisition Models
model Requisition {
  id            String             @id @default(uuid())
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  title         String
  description   String
  amount        Decimal?
  category      String
  status        RequisitionStatus  @default(PENDING)
  priority      String             @default("NORMAL")
  workflowInstanceId String?       // Link to workflow instance
  projectId     String?            // Project budget this spend is charged to
  project       Project?           @relation(fields: [projectId], references: [id])
  approvals     RequisitionApproval[]
  lpo           LPO?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model RequisitionApproval {
  id              String           @id @default(uuid())
  requisitionId   String
  requisition     Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approverId      String
  level           Int
  role            String
  status          ApprovalStatus   @default(PENDING)
  comment         String?
  actedAt         DateTime?
  createdAt       DateTime         @default(now())
}

// Finance Models
model Budget {
  id          String   @id @default(uuid())
  category    String   @unique
  amount      Decimal
  spent       Decimal  @default(0)
  year        Int
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DepartmentBudget {
  id              String   @id @default(uuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  category        String
  allocatedAmount Decimal
  spentAmount     Decimal  @default(0)
  fiscalYear      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([departmentId, category, fiscalYear])
}

// Department projects - approved project budgets make up each department's budget
model Project {
  id             String        @id @default(uuid())
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id])
  name           String
  description    String
  fiscalYear     Int
  proposedBudget Decimal
  approvedBudget Decimal?
  spentAmount    Decimal       @default(0)
  status         ProjectStatus @default(PENDING_REVIEW)
  startDate      DateTime?
  endDate        DateTime?
  proposedById   String?
  proposedBy     Employee?     @relation("ProjectProposer", fields: [proposedById], references: [id])
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewComment  String?
  requisitions   Requisition[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([departmentId, fiscalYear])
  @@index([status])
}

model LPO {
  id              String      @id @default(uuid())
  requisitionId   String      @unique
  requisition     Requisition @relation(fields: [requisitionId], references: [id])
  lpoNumber       String      @unique
  vendorName      String
  vendorContact   String?
  estimatedAmount Decimal
  status          String      @default("ISSUED")
  issuedDate      DateTime    @default(now())
  expectedDelivery DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Attendance Models
model Attendance {
  id          String             @id @default(uuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id])
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  status      AttendanceStatus  @default(ABSENT)
  isLate      Boolean           @default(false)
  notes       String?
  isManual    Boolean           @default(false)
  correctedBy String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([employeeId, date])
}

// Payroll Models
model Salary {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id])
  baseSalary  Decimal
  allowance   Decimal  @default(0)
  bonus       Decimal  @default(0)
  deductions  Decimal  @default(0)
  effectiveDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payroll {
  id          String        @id @default(uuid())
  period      String        // e.g., "2024-01"
  startDate   DateTime
  endDate     DateTime
  status      PayrollStatus @default(PENDING)
  processedAt DateTime?
  processedBy String?
  workflowInstanceId String?
  approvals   PayrollApproval[]
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([period])
}

model Payslip {
  id          String   @id @default(uuid())
  payrollId   String
  payroll     Payroll  @relation(fields: [payrollId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  baseSalary  Decimal
  allowance   Decimal  @default(0)
  bonus       Decimal  @default(0)
  grossPay    Decimal
  tax         Decimal  @default(0)
  otherDeductions Decimal @default(0)
  netPay      Decimal
  payDate     DateTime?
  items       PayslipItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Itemised earnings and deductions shown on a payslip
model PayslipItem {
  id          String          @id @default(uuid())
  payslipId   String
  payslip     Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type        PayslipItemType
  code        String          // e.g., "BASIC", "ALLOWANCE", "PAYE", "PENSION", "LOAN"
  label       String
  amount      Decimal
  createdAt   DateTime        @default(now())

  @@index([payslipId])
}

// Staff loans - repaid through recurring payroll deductions once approved
model LoanApplication {
  id                 String     @id @default(uuid())
  employeeId         String
  employee           Employee   @relation(fields: [employeeId], references: [id])
  amount             Decimal
  termMonths         Int
  monthlyInstallment Decimal
  purpose            String
  status             LoanStatus @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewComment      String?
  deductionId        String?    @unique // Recurring payroll deduction created on approval
  repaymentStart     DateTime?
  repaymentEnd       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Deduction {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String   // e.g., "TAX", "INSURANCE", "LOAN"
  amount      Decimal
  description String?
  isRecurring Boolean  @default(false)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PayrollApproval {
  id          String        @id @default(uuid())
  payrollId   String
  payroll     Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  approverId  String
  level       Int
  status      ApprovalStatus @default(PENDING)
  comment     String?
  actedAt     DateTime?
  createdAt   DateTime      @default(now())
}

// Audit and Workflow Models
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
}

// Workflow Engine Models
model WorkflowTemplate {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  entityType    String   // e.g., "LEAVE_REQUEST", "REQUISITION", "PAYROLL"
  isActive      Boolean  @default(true)
  steps         WorkflowStep[]
  instances     WorkflowInstance[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkflowStep {
  id              String   @id @default(uuid())
  templateId      String
  template        WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order           Int
  name            String
  description     String?
  approverType    ApproverType // e.g., "LINE_MANAGER", "DEPARTMENT_HEAD", "ROLE", "SPECIFIC_USER"
  approverRole    String?  // e.g., "HR_ADMIN", "FINANCE"
  approverId      String?  // Specific user ID if approverType is SPECIFIC_USER
  isOptional      Boolean  @default(false)
  allowDelegation Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([templateId, order])
}

model WorkflowInstance {
  id              String   @id @default(uuid())
  templateId      String
  template        WorkflowTemplate @relation(fields: [templateId], references: [id])
  entityType      String
  entityId        String
  currentStep     Int      @default(1)
  status          WorkflowStatus @default(ACTIVE)
  initiatedBy     String
  initiatedAt     DateTime @default(now())
  completedAt     DateTime?
  actions         ApprovalAction[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ApprovalAction {
  id              String   @id @default(uuid())
  instanceId      String
  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId          String
  approverId      String
  action          ApprovalActionType // e.g., "APPROVED", "REJECTED", "DELEGATED"
  comment         String?
  previousStatus  String?
  newStatus       String?
  actedAt         DateTime @default(now())
  createdAt       DateTime @default(now())
}

model NotificationQueue {
  id          String   @id @default(uuid())
  recipientId String
  type        NotificationType
  channel     NotificationChannel // e.g., "EMAIL", "SMS", "IN_APP"
  subject     String?
  message     String
  metadata    Json?
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  retryCount  Int      @default(0)
  scheduledFor DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Enums
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  FINANCE_OFFICER
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

}

enum RequisitionStatus {
  PENDING
  MANAGER_APPROVED
  FINANCE_APPROVED
  APPROVED
  REJECTED
  CANCELLED
  PENDING_MANAGER_APPROVAL
  PENDING_DEPARTMENT_APPROVAL
  PENDING_FINANCE_APPROVAL
  PENDING_PROCUREMENT
  PROCESSED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  HALF_DAY
}

enum PayrollStatus {
  PENDING
  PROCESSING
  PROCESSED
  PAID
  CANCELLED
}

enum PayslipItemType {
  EARNING
  DEDUCTION
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProjectStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobType {
  PAYROLL_PROCESSING
  ATTendance_REMINDER
  LEAVE_APPROVAL_REMINDER
  REPORT_GENERATION
  DATA_CLEANUP
}

// Workflow Engine Enums
enum ApproverType {
  LINE_MANAGER
  DEPARTMENT_HEAD
  ROLE
  SPECIFIC_USER
}

enum WorkflowStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ESCALATED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  DELEGATED
  RETURNED
}

enum NotificationType {
  LEAVE_SUBMISSION
  LEAVE_APPROVAL
  LEAVE_REJECTION
  REQUISITION_SUBMISSION
  REQUISITION_APPROVAL
  REQUISITION_REJECTION
  PAYROLL_UPLOADED
  PAYROLL_APPROVED
  WORKFLOW_ESCALATION
  SYSTEM_ALERT
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model BackgroundJob {
  id          String    @id @default(uuid())
  type        JobType
  status      JobStatus  @default(PENDING)
  payload     Json?
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
